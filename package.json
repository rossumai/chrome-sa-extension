{
  "name": "rossumai/rossum-sa-extension",
  "description": "Developer tools for Rossum, NetSuite, and Coupa: overlay schema/resource IDs, expand formulas, manage datasets, and show API field names.",
  "homepage": "https://github.com/rossumai/rossum-sa-extension",
  "bugs": "https://github.com/rossumai/rossum-sa-extension/issues",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:rossumai/rossum-sa-extension.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,tsx,css}\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@astral-sh/ruff-wasm-web": "^0.17.5",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@preact/signals": "^2.11.4",
    "beautiful-mermaid": "^1.1.3",
    "codemirror": "^6.0.2",
    "d3-force-3d": "^3.0.6",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.12.0",
    "json5": "^2.2.3",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.1.0",
    "markdown-it-github-alerts": "^1.0.1",
    "preact": "^11.2.0",
    "three": "^0.187.0"
  },
  "optionalDependencies": {
    "@mrtnzlml/rdc-wasm": "^0.16.0"
  }
}
